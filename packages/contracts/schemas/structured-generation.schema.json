{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowdlens/structured-generation@v1",
  "title": "StructuredGeneration",
  "type": "object",
  "required": ["request", "result"],
  "additionalProperties": false,
  "properties": {
    "request": {
      "type": "object",
      "required": ["provider", "model_id", "prompt_prefix", "prompt_suffix", "json_schema", "schema_version"],
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["gemini", "openrouter", "mock"] },
        "model_id": { "type": "string" },
        "prompt_prefix": { "type": "string" },
        "prompt_suffix": { "type": "string" },
        "json_schema": { "type": "object" },
        "schema_version": { "type": "string" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "session_id": { "type": "string" },
        "data_policy": {
          "type": "object",
          "properties": {
            "data_collection": { "enum": ["allow", "deny"] },
            "zdr": { "type": "boolean" }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["data", "provider", "model_id", "latency_ms", "usage"],
      "additionalProperties": false,
      "properties": {
        "data": {},
        "provider": { "enum": ["gemini", "openrouter", "mock"] },
        "model_id": { "type": "string" },
        "endpoint": { "type": "string" },
        "request_id": { "type": "string" },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "usage": {
          "type": "object",
          "required": ["input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "cached_input_tokens": { "type": "integer", "minimum": 0 },
            "cost_estimate_micro_usd": { "type": "integer" },
            "usage_is_estimate": { "type": "boolean" }
          }
        },
        "cache_metadata": { "type": "object" },
        "raw_artifact_ref": { "type": "string" }
      }
    }
  }
}
