{
  "name": "crowdlens",
  "version": "0.1.0",
  "private": true,
  "description": "CrowdLens — source-grounded, multi-agent scenario analysis (multi-tenant SaaS evolution of MiroFish-Offline)",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "dev:api": "pnpm --filter @crowdlens/control-api run dev",
    "dev:web": "pnpm --filter @crowdlens/web run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "pnpm --filter @crowdlens/control-api run test:integration",
    "test:e2e": "pnpm --filter @crowdlens/control-api run smoke:e2e",
    "db:migrate": "pnpm --filter @crowdlens/control-api run db:migrate"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
