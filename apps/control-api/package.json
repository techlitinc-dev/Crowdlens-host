{
  "name": "@crowdlens/control-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CrowdLens control plane: multi-tenant REST API, SSE, webhooks, billing, provider gateway",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "smoke:e2e": "tsx test/e2e/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.716.0",
    "@aws-sdk/s3-request-presigner": "3.716.0",
    "@crowdlens/contracts": "workspace:*",
    "@crowdlens/observability": "workspace:*",
    "@google/genai": "1.2.0",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "ajv": "8.17.1",
    "express": "4.21.2",
    "ioredis": "5.4.2",
    "jose": "5.9.6",
    "openai": "4.77.0",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "embedded-postgres": "17.11.0-beta.19",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
