# CrowdLens configuration contract (placeholders only — never commit real values).
# See instructions.md §6. Every value is validated at process startup.

APP_ENV=local
WEB_ORIGIN=http://localhost:3000
CONTROL_API_ORIGIN=http://localhost:4000

# Identity: OIDC provider. When OIDC_ISSUER is empty, the local development
# identity provider is active (session-based, no external IdP required).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET_REFERENCE=dev-session-secret-change-me

DATABASE_URL=postgres://crowdlens:crowdlens@localhost:5432/crowdlens
# Set EMBEDDED_PG_DATA_DIR to run an embedded PostgreSQL instance (local dev
# without Docker). Leave empty when DATABASE_URL points at a real server.
EMBEDDED_PG_DATA_DIR=.data/pg

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD_REFERENCE=

# Redis: when empty, the in-memory cache adapter is used (derived state only).
REDIS_URL=

TEMPORAL_ADDRESS=localhost:7233

# Object storage: S3-compatible (e.g. MinIO). When S3_ENDPOINT is empty, the
# local filesystem object-store adapter is used under .data/objects.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=crowdlens-artifacts
S3_ACCESS_KEY_REFERENCE=
S3_SECRET_KEY_REFERENCE=

GEMINI_API_KEY_REFERENCE=
OPENROUTER_API_KEY_REFERENCE=
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=CrowdLens

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET_REFERENCE=
RAZORPAY_WEBHOOK_SECRET_REFERENCE=
RAZORPAY_MODE=test

CREDIT_RATE_CARD_VERSION=credits-2026-11-09
MODEL_CATALOG_VERSION=models-2026-11-09
PROMPT_BUNDLE_VERSION=prompts-2026-11-09
